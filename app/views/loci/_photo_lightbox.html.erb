<%# Shared full-size photo popup for the locus page. The enclosing .locus-show
    sets x-data; each thumbnail sets open/img/caption/meta on click. Click the
    backdrop, the ✕, or Esc to close. %>
<div x-show="open" x-cloak
     @click="open=false" @keydown.escape.window="open=false"
     class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 p-4">
  <div @click.stop class="bg-white rounded-xl max-w-4xl w-full max-h-[90vh] overflow-auto shadow-xl">
    <div class="flex justify-end p-2">
      <button type="button" @click="open=false" aria-label="Close"
              class="text-[#6a5d4c] hover:text-[#2a231b] text-3xl leading-none px-2">&times;</button>
    </div>
    <%# Image + annotation overlay. The SVG shares the image's object-contain
        letterbox (natural-size viewBox + meet), so normalized coords align. %>
    <div class="relative bg-black" data-controller="annotation-overlay"
         :data-annotation-overlay-annotations-value="JSON.stringify(annotations)">
      <img :src="img" alt="" data-annotation-overlay-target="image"
           class="w-full max-h-[70vh] object-contain bg-black">
      <svg data-annotation-overlay-target="svg" aria-hidden="true"
           class="absolute inset-0 w-full h-full pointer-events-none"></svg>
    </div>
    <div class="p-4 border-t border-[#e7dcc4]">
      <div class="font-medium text-[#2a231b]" x-text="caption"></div>
      <div class="text-sm text-[#6a5d4c] mt-1" x-show="meta" x-text="meta"></div>
      <div class="text-xs text-[#8a7a2b] mt-1" x-show="annotations.length"
           x-text="annotations.length + (annotations.length === 1 ? ' annotation' : ' annotations')"></div>
    </div>
  </div>
</div>
