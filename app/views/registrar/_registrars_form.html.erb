<div class="row mb-3">
  <div class="col">
    <h1><%= "Registration Details for Field Find" %></h1>
  </div>
</div>
<% @descriptions['registar_info'].each do |find| %>
  <div class="form-group">
    <label><%= find['label'] %></label>
    <%= input_for(find, @find.dig(find['key']),'find') %>
  </div>
<% end %>
