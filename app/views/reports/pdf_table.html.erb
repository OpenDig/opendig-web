<div class="container">
  <div class="row">
    <div class="col-12">
      <h1>Khirbat al-Balu'a</h1>
      <h2>Balu'a Regional Archaeology Project</h2>
      <h3><%= @season %> <%= @report_type_title %> Report</h3>
  </div>
</div>
<% if @rows.empty? %>
  <%= render 'empty' %>
<% elsif @grouped %>
  <% @grouped.each_with_index do |(label, rows), i| %>
    <h4 class="report-group<%= ' page-break' if i.positive? %>"><%= label %></h4>
    <%= render 'data_table', rows: rows %>
  <% end %>
<% else %>
  <%= render 'data_table', rows: @rows %>
<% end %>
