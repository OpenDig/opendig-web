<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <h1>Khirbat al-Balu'a</h1>
      <h2>Balu'a Regional Archaeology Project</h2>
      <h3><%= @season %> <%= @report_type_title %> Report</h3>
  </div>
  <% if @rows.empty? %>
    <%= render 'empty' %>
  <% elsif @grouped %>
    <% @grouped.each do |label, rows| %>
      <h4 class="report-group"><%= label %></h4>
      <%= render 'photo_cards', rows: rows %>
    <% end %>
  <% else %>
    <%= render 'photo_cards', rows: @rows %>
  <% end %>
</div>
