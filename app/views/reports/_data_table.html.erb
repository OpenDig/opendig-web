<table>
  <thead>
    <tr>
      <% @field_set.each do |field_set| %>
        <th><%= field_set.keys.first %></th>
      <% end %>
    </tr>
  </thead>
  <tbody>
    <% rows.each do |row| %>
      <tr>
        <% @field_set.each do |field_set| %>
          <td><%= row.dig(field_set.values.first) %></td>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>
