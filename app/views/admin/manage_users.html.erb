<div class="container mx-auto max-w-4xl px-2 py-8">
  <h1 class="font-serif text-4xl text-[#2a231b] mb-6 text-center">User Management</h1>

  <%= render 'admin/invite_form' %>

  <% can_delete = current_user.superuser? %>
  <div class="mt-8" <%= 'data-controller=bulk-select' if can_delete %>>
    <div class="mb-3 flex items-center justify-between gap-4">
      <h2 class="font-serif text-2xl text-[#2a231b]">Members</h2>
      <% if can_delete %>
        <%= form_with url: admin_destroy_users_path, method: :delete, id: 'delete_users_form',
                      data: { turbo_confirm: 'Permanently delete the selected accounts? This removes them from every dig and cannot be undone.' } do |f| %>
          <%= f.submit 'Delete selected', disabled: true, data: { bulk_select_target: 'submit' },
                       class: 'rounded-full border border-[#f0c5bd] bg-[#fdecea] px-4 py-1.5 text-sm font-medium text-[#9c2a1c] hover:bg-[#f8d7d2] cursor-pointer disabled:cursor-not-allowed disabled:opacity-50' %>
        <% end %>
      <% end %>
    </div>
    <div class="overflow-x-auto rounded-xl border border-[#ddcfb4]">
      <table class="w-full text-sm">
        <thead class="bg-[#f1e9d8] text-left text-[#6a5d4c]">
          <tr>
            <% if can_delete %>
              <th class="w-8 px-4 py-3">
                <input type="checkbox" aria-label="Select all" data-bulk-select-target="all" data-action="bulk-select#toggleAll">
              </th>
            <% end %>
            <th class="px-4 py-3 font-medium">User</th>
            <th class="px-4 py-3 font-medium">Role</th>
            <th class="px-4 py-3 font-medium">Email</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#e7dcc4] bg-white">
          <% @users.each do |user| %>
            <tr class="align-top hover:bg-[#fbf6ec]">
              <% if can_delete %>
                <td class="px-4 py-3">
                  <% unless user == current_user || user.superuser? %>
                    <input type="checkbox" name="user_ids[]" value="<%= user.id_as_string %>" form="delete_users_form"
                           aria-label="Select <%= user.name %>" data-bulk-select-target="item" data-action="bulk-select#update">
                  <% end %>
                </td>
              <% end %>
              <td class="px-4 py-3">
                <span class="text-[#2a231b]"><%= user.name %></span>
                <% if user == current_user %>
                  <span class="text-xs text-[#9c8e78]">(You)</span>
                <% end %>
                <div class="mt-0.5 text-xs text-[#9c8e78]">
                  <%= user.provider == User::EMAIL_PROVIDER ? 'Email & password' : user.provider.to_s.sub('_oauth2', '').humanize %>
                  <% if user.pending_verification? %>
                    · <span class="text-[#9c2a1c]">Unconfirmed</span>
                  <% end %>
                </div>
              </td>
              <td class="px-4 py-3 w-1/3">
                <%= render partial: 'admin/manage_users_role_form', locals: { user: user, open: params[:open] == user.id_as_string } %>
              </td>
              <td class="px-4 py-3 text-[#6a5d4c]"><%= user.email %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <% if @invitations.present? %>
    <div class="mt-10">
      <h2 class="font-serif text-2xl text-[#2a231b] mb-3">Pending Invitations</h2>
      <div class="overflow-x-auto rounded-xl border border-[#ddcfb4]">
        <table class="w-full text-sm">
          <thead class="bg-[#f1e9d8] text-left text-[#6a5d4c]">
            <tr>
              <th class="px-4 py-3 font-medium">Email</th>
              <th class="px-4 py-3 font-medium">Role</th>
              <th class="px-4 py-3 font-medium">Invited by</th>
              <th class="px-4 py-3 font-medium text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#e7dcc4] bg-white">
            <% @invitations.each do |invitation| %>
              <tr class="hover:bg-[#fbf6ec]">
                <td class="px-4 py-3 text-[#2a231b]"><%= invitation.email %></td>
                <td class="px-4 py-3 text-[#2a231b]">
                  <%= invitation.role.humanize %>
                  <% if invitation.scopes.present? %>
                    <span class="text-xs text-[#9c8e78]">(<%= invitation.scopes.join(', ') %>)</span>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-[#6a5d4c]"><%= invitation.invited_by %></td>
                <td class="px-4 py-3 text-right whitespace-nowrap">
                  <%= button_to 'Re-send', resend_invitation_path(email: invitation.email),
                                method: :post,
                                form: { class: 'inline' },
                                class: 'rounded-full border border-[#ddcfb4] bg-white px-3 py-1 text-sm font-medium text-[#2a231b] hover:bg-[#fbf6ec] cursor-pointer' %>
                  <%= button_to 'Revoke', revoke_invitation_path(email: invitation.email),
                                method: :delete,
                                form: { class: 'inline' },
                                class: 'rounded-full border border-[#f0c5bd] bg-[#fdecea] px-3 py-1 text-sm font-medium text-[#9c2a1c] hover:bg-[#f8d7d2] cursor-pointer',
                                data: { confirm: 'Revoke this invitation?' } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</div>
