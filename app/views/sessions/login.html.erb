<% content_for :title, 'Sign in' %>
<p class="eyebrow">Welcome back</p>
<h1>Sign in to OpenDig</h1>
<p class="sub">Use the account your dig director invited.</p>

<%= form_with url: login_path, method: :post do |f| %>
  <div class="field">
    <%= f.label :email, "Email" %>
    <%= f.email_field :email, value: @email, autofocus: true, autocomplete: "email", required: true %>
  </div>
  <div class="field">
    <%= f.label :password, "Password" %>
    <%= f.password_field :password, autocomplete: "current-password", required: true %>
    <% if mail_enabled? %>
      <p class="hint"><a href="<%= new_password_reset_path %>">Forgot your password?</a></p>
    <% end %>
  </div>
  <%= f.submit "Log in", class: "submit" %>
<% end %>

<div class="divider">or continue with</div>

<div class="providers">
  <%= button_to oauth_start_url("google_oauth2"), method: :post, class: "prov" do %>
    <%= render 'shared/google_icon' %>
    Google
  <% end %>
  <% if Rails.env.development? %>
    <%= button_to oauth_start_url("developer"), method: :post, class: "prov dev" do %>
      Developer (dev only)
    <% end %>
  <% end %>
</div>

<p class="foot">New to OpenDig? <a href="<%= signup_path %>">Create an account</a></p>
